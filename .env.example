# ISABELLA GENESIS ZERO-OPEX v3 - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# ============================================================================
# CORE DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL (Primary datastore - Kernel Cognitivo Central)
DATABASE_URL=postgresql://isabella_admin:${DB_PASSWORD}@postgres:5432/isabella_db
POSTGRES_URL=postgresql://isabella_admin:${DB_PASSWORD}@postgres:5432/isabella_db
POSTGRES_URL_NON_POOLING=postgresql://isabella_admin:${DB_PASSWORD}@postgres:5432/isabella_db

# BookPI Pipeline
BOOKPI_PIPELINE_STORAGE=postgres
BOOKPI_INTEGRITY_SECRET=generate-with-openssl-rand-base64-32

# ============================================================================
# INFERENCE PROVIDERS (At least one required for LLM capabilities)
# ============================================================================

# Ollama (Local inference - primary)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.3:8b

# OpenRouter (Free tier fallback)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_FREE_MODEL=google/gemini-flash-1.5
OPENAI_COMPAT_API_TOKEN=sk-or-v1-xxxxxxxxxxxx
OPENAI_COMPAT_MODEL_ID=google/gemini-flash-1.5

# Hugging Face (Models, datasets, inference)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_FREE_MODELS=meta-llama/Llama-3.2-3B-Instruct,google/gemma-2-2b-it
HYPERCORE_API_TOKEN=
HYPERCORE_SIGNING_KEY=

# Google Gemini (Free tier)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anthropic (Optional alternative)
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Groq (Fast inference free tier)
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=female-en

# Gratis API
GRATIS_API_KEY=
GRATIS_API_MODEL=
GRATIS_API_URL=

# Key Less Free Provider
KEYLESS_FREE_PROVIDER=pollinations
KEYLESS_FREE_PROVIDER_TIMEOUT_MS=30000

# ============================================================================
# MULTIMODAL APIS
# ============================================================================

# StepAudio 3 Music Generation
STEP_API_KEY=sk_step_xxxxxxxxxxxxxxxxxxxx

# WAN 2.2 I2V (Uses Gradio space - no separate key needed if using public space)
# WAN_GRADIO_URL=https://kulkas2pintu-wan777.hf.space

# ============================================================================
# PAYMENT & BILLING
# ============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Connector
CONNECTOR_PROVIDERS=
CONNECTOR_TENANT_MAP=
CONNECTOR_WEBHOOK_SECRET=

# ============================================================================
# OPERATIONAL & SECURITY
# ============================================================================

# App Configuration
NODE_ENV=production
APP_PUBLIC_URL=https://isabella.tamv.online
PUBLIC_URL=https://isabella.tamv.online
HOST=0.0.0.0
PORT=8080
CROWN_CONSTITUTION_VERSION=RC-0.1a
LLM_DEFAULT_MODEL=google/gemini-flash-1.5

# BookPI Signing
BOOKPI_SIGNATURE_ALGORITHM=ML-DSA-65
GENESIS_DOCUMENT_SEAL_KEY_PEM=
GENESIS_HUMAN_APPROVAL_TOKEN=
GENESIS_HUMAN_APPROVER_ID=

# Operational Tokens (Generate with: openssl rand -base64 32)
GENESIS_ADMIN_API_TOKEN=generate-with-openssl-rand-base64-32
OPS_API_TOKEN=generate-with-openssl-rand-base64-32
HSF_API_TOKEN=generate-with-openssl-rand-base64-32
GENESIS_PUBLIC_API_TOKEN=generate-with-openssl-rand-base64-32

# Approval System (Human-in-the-loop)
# Generate keys with: openssl genpkey -algorithm ED25519 -out private_key.pem
# openssl pkey -in private_key.pem -pubout -out public_key.pem
ISABELLA_APPROVAL_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ISABELLA_APPROVAL_TRUSTED_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ISABELLA_APPROVAL_KEY_ID=key-1
ISABELLA_APPROVAL_TRUSTED_KEY_ID=key-1
ISABELLA_APPROVAL_TRUSTED_APPROVER_ID=human-approver-001

# Gameover
GAMEOVER_PASSPORT_PATH=

# Chat
CHAT_CHAIN_BUDGET_MS=5000
CHAT_HEDGE_DELAY_MS=500

# Inference
INFERENCE_TIMEOUT_MS=30000
MULTIMODAL_TIMEOUT_MS=60000

# Model
MODEL_API_KEY=
ISABELLA_BOT_NAME=Isabella
ISABELLA_BOT_VERSION=1.0.0
ISABELLA_LANGUAGE=es
ISABELLA_MAX_RESPONSE_LENGTH=4096

# Reconnection
RECONCILIATION_MAX_ATTEMPTS=3
RECONCILIATION_RETRY_BASE_MS=1000
RECONCILIATION_RETRY_MAX_MS=10000
RECONCILIATION_TIMEOUT_MS=30000

# Session
SESSION_MEMORY_MAX_MESSAGES=100
SESSION_MEMORY_MAX_SESSIONS=1000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PennyLane
PENNYLANE_DEVICE=lightning.qubit
PENNYLANE_SHOTS=1000
PENNYLANE_BRIDGE_TIMEOUT_MS=30000
PENNYLANE_BRIDGE_URL=
PENNYLANE_BACKEND=

# Proxy
TRUST_PROXY=true

# Vercel
VERCEL=false
VERCEL_OIDC_TOKEN=

# Other
VITEST=false
ZENODO_DOI=
ORCID_ID=
ISNI=
DATACITE_DOI=
ISNI=
PID_NAMESPACE=
PID_STRICT=false
AI_GATEWAY_API_KEY=
POSTGRES_PRISMA_URL=

# ============================================================================
# TELEMETRY
# ============================================================================

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel:4318/v1/metrics

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ALLOW_PAID_PROVIDER_FALLBACK=false
ISABELLA_KEYLESS_FREE_PROVIDER=pollinations
STRICT_PREFLIGHT=true
# Runtime smoke-test mode; set to 1 only for isolated smoke checks.
RUNTIME_SMOKE=0
PROVIDER_FAILURE_COOLDOWN_MS=30000

# ============================================================================
# PAYMENT & BILLING
# ============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Connector
CONNECTOR_PROVIDERS=
CONNECTOR_TENANT_MAP=
CONNECTOR_WEBHOOK_SECRET=

# ============================================================================
# MULTIMODAL APIS
# ============================================================================

# StepAudio 3 Music Generation
STEP_API_KEY=sk_step_xxxxxxxxxxxxxxxxxxxx

# WAN 2.2 I2V (Uses Gradio space - no separate key needed if using public space)
# WAN_GRADIO_URL=https://kulkas2pintu-wan777.hf.space

# ============================================================================
# BOOKPI PIPELINE
# ============================================================================

BOOKPI_PIPELINE_STORAGE=postgres
BOOKPI_INTEGRITY_SECRET=generate-with-openssl-rand-base64-32
BOOKPI_LEDGER_PATH=/var/lib/bookpi/ledger
BOOKPI_PIPELINE_LEDGER_PATH=/var/lib/bookpi/ledger

# ============================================================================
# OPTIONAL / ADVANCED
# ============================================================================

# Neo4j (Optional - if using external graph DB instead of Apache AGE)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Qdrant (Optional - if using external vector DB instead of pgvector)
QDRANT_URL=https://qdrant:6333
QDRANT_API_KEY=qdrant-api-key

# Redis (Optional - if using external Redis instead of pg_advisory_lock/pgmq)
REDIS_URL=redis://redis:6379

# S3/MinIO (Optional - if using external object storage)
S3_ENDPOINT=https://s3.region.amazonaws.com
S3_ACCESS_KEY=accesskey
S3_SECRET_KEY=secretkey
S3_BUCKET=isabella-artifacts

# PennyLane Quantum Bridge
PENNYLANE_DEVICE=lightning.qubit
PENNYLANE_SHOTS=1000
PENNYLANE_BRIDGE_TIMEOUT_MS=30000
PENNYLANE_BRIDGE_URL=
PENNYLANE_BACKEND=

# IGE-Omega Rust Gateway (Optional)
IGE_OMEGA_ENDPOINT=http://ige-omega:8080

# Migration Mode
BOOKPI_PIPELINE_LEDGER_PATH=/var/lib/bookpi/ledger

# Datacite
DATACITE_DOI=

# Isni
ISNI=

# Orcid
ORCID_ID=

# Zenodo
ZENODO_DOI=

