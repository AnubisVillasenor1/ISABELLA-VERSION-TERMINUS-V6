# Isabella V6 — local environment template
# Never commit real values. Use Vercel Project Vars / .env.development.local.

# Connected integrations already provisioned in this project
AI_GATEWAY_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Runtime and public URL
# PID reconciliation safety controls (CLI only): bounded timeout and jittered retries.
RECONCILIATION_TIMEOUT_MS=30000
RECONCILIATION_MAX_ATTEMPTS=3
RECONCILIATION_RETRY_BASE_MS=1000
RECONCILIATION_RETRY_MAX_MS=10000
APP_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
INFERENCE_TIMEOUT_MS=8000
PROVIDER_FAILURE_COOLDOWN_MS=60000
ALLOW_PAID_PROVIDER_FALLBACK=false

# Model providers (optional; configure at least one for server-side generation)
GEMINI_API_KEY=
MODEL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
HF_TOKEN=
HF_FREE_MODELS=
# Ollama Cloud: OpenAI-compatible managed catalog. Requires a model ID valid for
# the account (list with: curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/v1/models).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:20b
# OpenAI-compatible providers: optional, only configured keys are attempted in order.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.1-8b
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
INFERENCE_API_KEY=
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_EMBEDDING_MODEL=
MODEL_ENDPOINT=

# BookPI persistence
# Optional local JSONL ledger for local/dev use only. A local file on Vercel/serverless
# is not a shared multi-instance source of truth and is not WORM storage.
# BOOKPI_LEDGER_PATH=./data/bookpi/ledger.jsonl

# Governance, identity and protected APIs
BOOKPI_INTEGRITY_SECRET=
TOKEN_ENCRYPTION_KEY=
HSF_API_TOKEN=
GENESIS_ADMIN_API_TOKEN=
ISABELLA_APPROVAL_KEY_ID=
ISABELLA_APPROVAL_PRIVATE_KEY_PEM=
ISABELLA_APPROVAL_TRUSTED_KEY_ID=
ISABELLA_APPROVAL_TRUSTED_PUBLIC_KEY_PEM=
ISABELLA_APPROVAL_TRUSTED_APPROVER_ID=
WEBHOOK_SIGNING_SECRET=
CONNECTOR_WEBHOOK_SECRET=
CONNECTOR_PROVIDERS=stripe,github,slack,linear
CONNECTOR_TENANT_MAP=

# Multimodal (image understanding / synthesis) and speech (TTS/STT).
# Each capability is key-driven and fails closed: nothing is attempted without a
# provider credential; model overrides below are optional and provider keys are reused.
# Vision (image -> text): configure any one of these.
OPENROUTER_VISION_MODEL=
GEMINI_VISION_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_API_BASE=
HF_VISION_MODELS=
HF_IMAGE_MODELS=
NOVITA_VISION_MODEL=
NOVITA_IMAGE_MODEL=
TOGETHER_VISION_MODEL=
TOGETHER_IMAGE_MODEL=
DEEPINFRA_VISION_MODEL=
DEEPINFRA_IMAGE_MODEL=
FIREWORKS_VISION_MODEL=
FIREWORKS_IMAGE_MODEL=
# Local OpenAI-compatible vision/image servers (llama.cpp, vLLM, Ollama).
LOCAL_VISION_BASE_URL=
LOCAL_VISION_MODEL=
LOCAL_VISION_API_KEY=
LOCAL_IMAGE_BASE_URL=
LOCAL_IMAGE_MODEL=
LOCAL_IMAGE_API_KEY=
# Per-request budget for vision/image routes. Local CPU inference can take
# minutes on first (cold) load, so the default ceiling is higher than INFERENCE_TIMEOUT_MS.
MULTIMODAL_TIMEOUT_MS=120000
# Speech (Groq Orpheus TTS + Whisper STT). Requires accepting Groq model terms once.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_STT_MODEL=whisper-large-v3

# Observability and optional services
OTEL_EXPORTER_OTLP_ENDPOINT=
PENNYLANE_BRIDGE_URL=
PENNYLANE_BRIDGE_TIMEOUT_MS=5000
PENNYLANE_BACKEND=pennylane-lightning
FIREBASE_API_KEY=
PAYMENT_PROVIDER_SECRET=

# Added 2026-10-13 (engine-generated, draft): variables read by the runtime that were undocumented.
NODE_ENV=production
# Process-wide AI Passport registry; durable when set (UAGP-1).
GAMEOVER_PASSPORT_PATH=
# Human approval for POST /api/v1/gameover/govern (both required to authenticate a principal).
GENESIS_HUMAN_APPROVAL_TOKEN=
GENESIS_HUMAN_APPROVER_ID=
# Token for provider-backed public/demo routes in production (Bearer, >=32 chars).
# Required for /api/v1/tools/execute, multimodal/voice routes, and external model selection.
GENESIS_PUBLIC_API_TOKEN=
# HyperCore routes (/api/v1/hypercore/*, /api/v1/mcp).
HYPERCORE_API_TOKEN=
HYPERCORE_SIGNING_KEY=
# Bearer token for GET /api/v1/ops/latency.
OPS_API_TOKEN=
# Kill switch (REINA / ISA-X): "1" or "true" halts every scope (fail-closed).
ISA_KILL_SWITCH=
# Optional "gratis" OpenAI-compatible provider.
GRATIS_API_URL=https://api.gratis.ai/v1
GRATIS_API_KEY=
GRATIS_API_MODEL=gpt-4o-mini
# Local deterministic engine.
ISABELLA_BOT_NAME=
ISABELLA_BOT_VERSION=
ISABELLA_LANGUAGE=
ISABELLA_MAX_RESPONSE_LENGTH=
# Session memory bounds.
SESSION_MEMORY_MAX_MESSAGES=50
SESSION_MEMORY_MAX_SESSIONS=1000
# Set automatically by Vercel / Vitest; do not set by hand.
# VERCEL=
# VERCEL_OIDC_TOKEN=
# VITEST=

# Number of trusted reverse-proxy hops (1..10) so req.ip / rate limits use X-Forwarded-For. Unset = do not trust it.
TRUST_PROXY=
