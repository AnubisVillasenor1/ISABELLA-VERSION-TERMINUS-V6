{
  "name": "isabella-villase-or-genesisai",
  "version": "0.1.0",
  "private": true,
  "description": "Isabella Villaseñor AI — Genesis TINA v40.0.0. Cognitive Orchestrator & Civilizational Memory OS.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "start:dist": "node dist/server.js",
    "start:native": "node --env-file=.env.native dist/server.js",
    "keys:generate": "node scripts/generate-native-keys.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/repository-assurance.mjs && tsc -p tsconfig.build.json && vitest run && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=dist/server.js && node --check src/ui/app.js && node scripts/ui-smoke.mjs && node scripts/runtime-smoke.mjs && pnpm run security:suite",
    "build:dist": "tsc -p tsconfig.build.json && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=dist/server.js",
    "lint": "tsc --noEmit",
    "reconcile:pids": "tsx src/cli/reconcilePids.ts",
    "bookpi:maintenance": "tsx src/cli/bookpiMaintenance.ts",
    "quantum:bridge": "python services/pennylane_bridge.py",
    "validate": "pnpm run typecheck && pnpm run build",
    "ingest:atlas": "tsx scripts/atlas-ingest.ts",
    "security:suite": "node scripts/security-suite.mjs",
    "production:evidence": "node scripts/production-evidence.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "smoke:ui": "node --check src/ui/app.js && node scripts/ui-smoke.mjs",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "verify:production": "tsx scripts/verify-production.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.110",
    "@google/genai": "^2.28.0",
    "ai": "^7.0.137",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@10.28.0"
}
