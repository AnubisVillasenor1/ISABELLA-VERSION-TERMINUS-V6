{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,src/ui/**,src/assets/video/**}"
    }
  },
  "rewrites": [{
    "source": "/:path*",
    "destination": "/api/:path*"
  }],
  "headers": []
}
